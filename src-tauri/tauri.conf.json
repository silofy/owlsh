{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "owlsh",
  "version": "0.2.0",
  "identifier": "dev.owlsh.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "owlsh — Session Report",
        "width": 1320,
        "height": 920,
        "minWidth": 900,
        "minHeight": 600
      },
      {
        "label": "widget",
        "url": "index.html?widget=1",
        "title": "owlsh — widget",
        "width": 360,
        "height": 330,
        "minWidth": 300,
        "minHeight": 240,
        "alwaysOnTop": true,
        "decorations": false,
        "resizable": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
